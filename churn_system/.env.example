[TEMPLATE]
# Copy to .env (same folder as docker-compose.yml) if you want to change these.
# All values are optional.

# Require an API key on every endpoint when set. Leave empty for the default
# local demo setup.
CHURN_API_KEY=

# Allowed browser origins for the backend (comma separated).
CHURN_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Retention briefs (optional AI layer). Leave blank to use the built-in
# template. Any OpenAI-compatible endpoint works (OpenAI, OpenLLM gateway,
# Groq, ...). The model never sees the Client_ID.
BRIEF_LLM_API_KEY=
BRIEF_LLM_BASE_URL=https://api.openai.com/v1
BRIEF_LLM_MODEL=gpt-4o-mini
